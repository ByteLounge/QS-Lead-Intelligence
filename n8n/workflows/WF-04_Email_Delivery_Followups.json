{
  "name": "WF-04: Email Delivery and Follow-ups",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "e6a0d01b-9f6b-4e0e-89a4-000000000001",
      "name": "Schedule (15m)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM public.claim_eligible_outbound_messages(5);"
      },
      "id": "e6a0d01b-9f6b-4e0e-89a4-000000000002",
      "name": "Claim Eligible Outbound Messages",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-has-msg",
              "leftValue": "={{ $json.message_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "e6a0d01b-9f6b-4e0e-89a4-000000000003",
      "name": "Has Eligible Messages?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_URL || 'http://localhost:3000' }}/api/email/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "message_id",
              "value": "={{ $json.message_id }}"
            },
            {
              "name": "to",
              "value": "={{ $json.recipient_email }}"
            },
            {
              "name": "subject",
              "value": "={{ $json.subject }}"
            },
            {
              "name": "body",
              "value": "={{ $json.body }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "e6a0d01b-9f6b-4e0e-89a4-000000000004",
      "name": "Dispatch via Email API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [900, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.outreach_messages\nSET status = 'sent',\n    sent_at = now(),\n    provider_message_id = $2,\n    updated_at = now()\nWHERE id = $1;\n\nINSERT INTO public.activities (\n  lead_id,\n  activity_type,\n  title,\n  description,\n  metadata\n) VALUES (\n  $3,\n  'email_sent',\n  'Outreach email delivered',\n  'Sent to ' || $4,\n  json_build_object('recipient', $4, 'subject', $5, 'sequence_number', $6)::jsonb\n);",
        "queryParams": "={{ [ $json.message_id, 'gmail-msg-' + Math.random().toString(36).substring(2, 10), $json.lead_id, $json.recipient_email, $json.subject, $json.sequence_number ] }}"
      },
      "id": "e6a0d01b-9f6b-4e0e-89a4-000000000005",
      "name": "Mark Sent & Log Activity",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🚀 *Outreach Email Sent*\n*To:* {{ $json.recipient_name }} <{{ $json.recipient_email }}>\n*Subject:* {{ $json.subject }}\n*Sequence:* {{ $json.sequence_number == 0 ? 'Day 0 Initial Intro' : ($json.sequence_number == 1 ? 'Day 4 Follow-up' : 'Day 9 Break-up') }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "e6a0d01b-9f6b-4e0e-89a4-000000000006",
      "name": "Telegram Dispatch Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1340, 300]
    }
  ],
  "connections": {
    "Schedule (15m)": {
      "main": [
        [
          {
            "node": "Claim Eligible Outbound Messages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim Eligible Outbound Messages": {
      "main": [
        [
          {
            "node": "Has Eligible Messages?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Eligible Messages?": {
      "main": [
        [
          {
            "node": "Dispatch via Email API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch via Email API": {
      "main": [
        [
          {
            "node": "Mark Sent & Log Activity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark Sent & Log Activity": {
      "main": [
        [
          {
            "node": "Telegram Dispatch Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}
