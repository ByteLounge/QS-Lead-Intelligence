# Queenstown Lead Intelligence - Environment Configuration
# Copy this file to .env.local for local development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI - Google Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Discovery - Google Places API
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Email - Gmail Transport (Choose Option A or Option B)
# Option A (Recommended & Easiest): 16-character Google App Password
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-16-char-app-password
SENDER_EMAIL=queenstownlabs@gmail.com

# Option B: Google Cloud OAuth2 API
GMAIL_CLIENT_ID=your-gmail-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback
GMAIL_REFRESH_TOKEN=

# Notifications - Discord Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-id/your-token

# Notifications - Telegram Bot API
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Automation - n8n
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret
N8N_ENCRYPTION_KEY=your-n8n-encryption-key-32-chars-min

# Application
APP_URL=http://localhost:3000
APP_ENV=development
