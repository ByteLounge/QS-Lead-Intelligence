{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node --require ./patch-readlink.cjs ./node_modules/next/dist/bin/next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/discovery",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/dispatch",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 18 * * *"
    }
  ]
}
